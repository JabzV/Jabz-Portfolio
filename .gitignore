# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vendored agent skills (8.5MB, 235 files) — reinstall with:
#   npx -y skills@latest add vercel-labs/skills --skill find-skills --agent claude-code --project --copy -y
#   npx -y skills@latest add nextlevelbuilder/ui-ux-pro-max-skill --skill '*' --agent claude-code --project --copy -y
#   npx -y skills@latest add greensock/gsap-skills -s gsap-core -s gsap-scrolltrigger -s gsap-performance -s gsap-timeline --agent claude-code --project --copy -y
/.claude/skills
